{
  "name": "@agentuse/artifacts",
  "version": "0.3.0",
  "description": "CLI + viewer for collecting artifacts emitted by AI agents",
  "type": "module",
  "license": "MIT",
  "author": "Leon Ho",
  "homepage": "https://github.com/agentuse/artifacts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentuse/artifacts.git"
  },
  "bugs": {
    "url": "https://github.com/agentuse/artifacts/issues"
  },
  "keywords": [
    "agent",
    "artifacts",
    "cli",
    "viewer",
    "markdown",
    "ai",
    "agentuse"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "artifacts": "dist/bin.js"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "viewer-dist"
  ],
  "scripts": {
    "build": "npm run build:viewer && npm run build:cli",
    "build:cli": "tsc -p tsconfig.json",
    "build:viewer": "cd viewer && npm install --silent && npm run build",
    "link": "npm run build && npm link",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/bin.ts",
    "dev:server": "tsx watch src/bin.ts serve",
    "dev:viewer": "cd viewer && npm run dev",
    "watch:viewer": "cd viewer && vite build --watch --outDir ../viewer-dist",
    "watch": "concurrently -n server,viewer -c cyan,yellow \"npm:dev:server\" \"npm:watch:viewer\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "release:dry": "npm publish --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "node-html-parser": "^6.1.13",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
